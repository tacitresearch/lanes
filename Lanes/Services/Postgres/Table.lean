module

public import Lanes.Services.Postgres.Conn
public import Lanes.Outside.Store.Basic

/-!
A PostgreSQL table as the transactional store of `Lanes/Outside/Store/Basic.lean`, with keys
`Nat` and values `String`: the SQL each operation is sent as (`Table.request`) and what the reply
means (`Table.answer`), pure, so that the IO that runs it decides nothing (rule 3.9).

The table is `key bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, value text NOT NULL`:
`insert` is refused by its primary key when the key is there, and `append` takes the key its
identity gives. That PostgreSQL then behaves like the model at the isolation level asked for is
the premise of every theorem proved against the model, tested on recorded runs
(`Tests/PostgresLive.lean`), not proved.
-/

@[expose] public section

namespace Lanes.Postgres

/-- A table, named by an identifier of lowercase letters, digits and `_`, not starting with a
digit, so that its name can be put in SQL as it is. -/
structure Table where
  name : String
  name_ok : (name.toList.all fun c => c.isLower || c.isDigit || c == '_')
    && name.toList.head?.any (fun c => !c.isDigit) := by decide

namespace Table

variable (t : Table)

def create : Statement :=
  { sql := s!"CREATE TABLE IF NOT EXISTS {t.name} (key bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, value text NOT NULL)" }

def Isolation.ofStore : Store.Isolation → Isolation
  | .readCommitted => .readCommitted
  | .serializable => .serializable

def request (isolation : Store.Isolation) : Store.Op Nat String → Request
  | .begin => .begin (Isolation.ofStore isolation)
  | .read k => .statement { sql := s!"SELECT value FROM {t.name} WHERE key = $1", params := [some (toString k)] }
  | .scan => .statement { sql := s!"SELECT key, value FROM {t.name} ORDER BY key" }
  | .write k v => .statement
      { sql := s!"INSERT INTO {t.name} (key, value) VALUES ($1, $2) ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value"
        params := [some (toString k), some v] }
  | .insert k v => .statement
      { sql := s!"INSERT INTO {t.name} (key, value) VALUES ($1, $2)", params := [some (toString k), some v] }
  | .append v => .statement
      { sql := s!"INSERT INTO {t.name} (value) VALUES ($1) RETURNING key", params := [some v] }
  | .delete k => .statement { sql := s!"DELETE FROM {t.name} WHERE key = $1", params := [some (toString k)] }
  | .commit => .commit
  | .rollback => .rollback

end Table

/-- The rows of a scan, keys read as numbers; `none` if one is not. -/
def scanRows : List (List (Option String)) → Option (List (Nat × String))
  | [] => some []
  | [some k, some v] :: rest => do
    let k ← k.toNat?
    pure ((k, v) :: (← scanRows rest))
  | _ => none

/-- What a reply to the request an operation was sent as means. A reply that does not have the
shape the operation's SQL gives is a failure: it did not do what was asked. -/
def Table.answer : Store.Op Nat String → Reply → Store.Answer Nat String
  | _, .unknown => .unknown
  | _, .error _ | _, .refused _ | _, .tooManyRows => .failed
  | .commit, .committed => .committed
  | .commit, _ => .failed
  | .rollback, _ => .ok
  | .begin, .rows _ => .ok
  | .read _, .rows r =>
    match r.rows with
    | [] => .value none
    | [[some v]] => .value (some v)
    | _ => .failed
  | .scan, .rows r => (scanRows r.rows).elim .failed .rows
  | .write .., .rows _ | .insert .., .rows _ | .delete _, .rows _ => .ok
  | .append _, .rows r =>
    match r.rows with
    | [[some k]] => (k.toNat?).elim .failed .key
    | _ => .failed
  | _, _ => .failed

/-- Whether a transaction is over once an operation got an answer, so that its connection is
closed: after `commit` and `rollback`, a failure, or no answer. -/
def Table.over : Store.Op Nat String → Store.Answer Nat String → Bool
  | .commit, _ | .rollback, _ | _, .failed | _, .unknown => true
  | _, _ => false

end Lanes.Postgres
