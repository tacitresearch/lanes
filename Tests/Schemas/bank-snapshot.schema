-- The pinned schema of an application's files. `lanes lint` checks that the build's schema
-- reads what this one wrote, and the corpus; `lanes lint --fix` writes this file again after
-- a change that old files read. The text is for people; the frame is what is checked.
kind: snapshot
schema: Tests.Corpus.Bank.snapshot
import: Tests.Corpus
corpus: Tests/Journals/bank

Prod Nat (Prod (List (Σ Nat)) (Prod (List (Prod (Option Nat) (Σ Nat))) (Prod (List (Prod (Prod Nat Nat) (Σ Nat))) (Prod Nat (Prod Nat Bool)))))

structure Prod Nat (Prod (List (Σ Nat)) (Prod (List (Prod (Option Nat) (Σ Nat))) (Prod (List (Prod (Prod Nat Nat) (Σ Nat))) (Prod Nat (Prod Nat Bool))))) where
  fst : Nat
  snd : Prod (List (Σ Nat)) (Prod (List (Prod (Option Nat) (Σ Nat))) (Prod (List (Prod (Prod Nat Nat) (Σ Nat))) (Prod Nat (Prod Nat Bool))))

structure Prod (List (Σ Nat)) (Prod (List (Prod (Option Nat) (Σ Nat))) (Prod (List (Prod (Prod Nat Nat) (Σ Nat))) (Prod Nat (Prod Nat Bool)))) where
  fst : List (Σ Nat)
  snd : Prod (List (Prod (Option Nat) (Σ Nat))) (Prod (List (Prod (Prod Nat Nat) (Σ Nat))) (Prod Nat (Prod Nat Bool)))

structure Prod (List (Prod (Option Nat) (Σ Nat))) (Prod (List (Prod (Prod Nat Nat) (Σ Nat))) (Prod Nat (Prod Nat Bool))) where
  fst : List (Prod (Option Nat) (Σ Nat))
  snd : Prod (List (Prod (Prod Nat Nat) (Σ Nat))) (Prod Nat (Prod Nat Bool))

structure Prod (Option Nat) (Σ Nat) where
  fst : Option Nat
  snd : Σ Nat

inductive Option Nat where
  | none
  | some (val : Nat)

structure Prod (List (Prod (Prod Nat Nat) (Σ Nat))) (Prod Nat (Prod Nat Bool)) where
  fst : List (Prod (Prod Nat Nat) (Σ Nat))
  snd : Prod Nat (Prod Nat Bool)

structure Prod (Prod Nat Nat) (Σ Nat) where
  fst : Prod Nat Nat
  snd : Σ Nat

structure Prod Nat Nat where
  fst : Nat
  snd : Nat

structure Prod Nat (Prod Nat Bool) where
  fst : Nat
  snd : Prod Nat Bool

structure Prod Nat Bool where
  fst : Nat
  snd : Bool

inductive Bool where
  | false
  | true

