import {{Name}}.Web

/-!
`{{name}} [port]`. The process keeps nothing: the count is in PostgreSQL, so the process can be
stopped, replaced or run as several instances behind a load balancer at any moment.

Everything else comes from the environment, so that a deployment sets it without a change here.
`setup` reads it once, at the start, and the app refuses to start with a list of every
variable that is not valid. It refuses to start when the database's tables differ from the ones
`{{Name}}.schema` declares. The server answers `/readyz` and `/healthz`, which a load balancer
asks, `/metrics` to this machine only, and writes an access log to stderr (`ServerConfig.ops`).
-/

open Lanes {{Name}}

structure Setup where
  host : String
  idle_ms : Nat
  drain_ms : Nat
  database : Option Secret
  migrations : String

open Environment in
def setup : Environment.Reader Setup := do
  let host ← get "LANES_HOST" "127.0.0.1"
    (doc := "The address to listen on: 0.0.0.0 behind a load balancer.")
  let idle_ms ← get "LANES_IDLE_MS" 10000 (doc := "How long an idle connection is kept.")
  let drain_ms ← get "LANES_DRAIN_MS" 10000
    (doc := "How long SIGTERM or SIGINT waits for the requests in flight.")
  let database ← secret? "DATABASE_URL"
    (doc := "A postgresql:// URI or libpq's keyword=value pairs. For what it leaves out, libpq's \
      variables (PGHOST, PGUSER, PGPASSWORD, …), then a deploy's (LANES_DB_HOST, \
      LANES_DB_PASSWORD_FILE, …): Postgres.Client.fromEnv.")
  let migrations ← get "LANES_MIGRATIONS" "migrations"
    (doc := "The directory of the .sql files each run once, in the order of their names, at the start.")
  return { host, idle_ms, drain_ms, database, migrations }

def main (args : List String) : IO UInt32 := do
  let port := (args.head? >>= String.toNat?).getD 8080
  let c ← Environment.load setup "{{name}}"
  let server : Http.ServerConfig :=
    { host := c.host, port := port.toUInt16, idle_ms := c.idle_ms
      ops := { readinessPath := some "/readyz", livenessPath := some "/healthz",
               metricsPath := some "/metrics", accessLog := .stderr, requestIds := true } }
  let postgres ← Postgres.Client.fromEnv ((c.database.map (·.reveal)).getD "")
  let migrations ← Postgres.Typed.readMigrations c.migrations
  match ← (Web.start postgres migrations server).block with
  | .error problems =>
    IO.eprintln "{{name}}: not started: the database is not ready, or not as declared:"
    for p in problems do IO.eprintln s!"  {p}"
    return 1
  | .ok running =>
    IO.println s!"{{name}} listening on http://{c.host}:{running.port.getD 0}"
    (← IO.getStdout).flush
    Lanes.block (running.stopOnSignal c.drain_ms)
    return 0
