-- The pinned schema of an application's files. `lanes lint` checks that the build's schema
-- reads what this one wrote, and the corpus; `lanes lint --fix` writes this file again after
-- a change that old files read. The text is for people; the frame is what is checked.
kind: journal
schema: Videos.Web.journalSchema
import: Videos.Serve
corpus: ../../Tests/Journals/videos

Lanes.Journal.Entry (Sum (Prod Nat Lanes.Http.Request) (Sum (Lanes.Schedule.Input Videos.Key Unit Videos.Answer) Videos.Input))

inductive Lanes.Journal.Entry (Sum (Prod Nat Lanes.Http.Request) (Sum (Lanes.Schedule.Input Videos.Key Unit Videos.Answer) Videos.Input)) where
  | input (x : Sum (Prod Nat Lanes.Http.Request) (Sum (Lanes.Schedule.Input Videos.Key Unit Videos.Answer) Videos.Input))
  | advance (now_ms : Nat)
  | batch (fuel : Nat)
  | handed
  | snapshot (index : Nat)

inductive Sum (Prod Nat Lanes.Http.Request) (Sum (Lanes.Schedule.Input Videos.Key Unit Videos.Answer) Videos.Input) where
  | inl (val : Prod Nat Lanes.Http.Request)
  | inr (val : Sum (Lanes.Schedule.Input Videos.Key Unit Videos.Answer) Videos.Input)

structure Prod Nat Lanes.Http.Request where
  fst : Nat
  snd : Lanes.Http.Request

structure Lanes.Http.Request where
  method : Lanes.Http.Method
  path : List String
  query : List (Prod String String)
  headers : List (Prod String String)
  body : ByteArray

inductive Lanes.Http.Method where
  | get
  | post
  | put
  | patch
  | delete

structure Prod String String where
  fst : String
  snd : String

inductive Sum (Lanes.Schedule.Input Videos.Key Unit Videos.Answer) Videos.Input where
  | inl (val : Lanes.Schedule.Input Videos.Key Unit Videos.Answer)
  | inr (val : Videos.Input)

inductive Lanes.Schedule.Input Videos.Key Unit Videos.Answer where
  | schedule (now_ms : Nat) (spec : Lanes.Schedule.Spec Videos.Key Unit)
  | cancel (key : Videos.Key)
  | reply (key : Videos.Key) (attempt : Nat) (reply : Lanes.Rpc.Reply Videos.Answer)

inductive Videos.Key where
  | check (video : Videos.VideoId) (req : Nat)
  | expire (video : Videos.VideoId)
  | transcode (round : Videos.Round)
  | delete (video : Videos.VideoId)

structure Videos.VideoId where
  owner : Videos.Who
  n : Nat

structure Videos.Who where
  issuer : String
  subject : String

structure Videos.Round where
  video : Videos.VideoId
  n : Nat

inductive Videos.Answer where
  | found (size : Nat)
  | missing
  | deleted
  | accepted
  | failed

structure Lanes.Schedule.Spec Videos.Key Unit where
  key : Videos.Key
  payload : Unit
  work : Lanes.Schedule.Work
  at_ms : Nat

inductive Lanes.Schedule.Work where
  | call (retry : Lanes.Schedule.Retry)
  | once
  | every (period_ms : Nat)

structure Lanes.Schedule.Retry where
  maxAttempts : Nat := 5
  deadline_ms : Nat := 10000
  base_ms : Nat := 1000
  cap_ms : Nat := 60000
  jitter_ms : Nat := 0
  until_ms : Option Nat := .none

inductive Option Nat where
  | none
  | some (val : Nat)

inductive Lanes.Rpc.Reply Videos.Answer where
  | answer (a : Videos.Answer)
  | unknown

inductive Videos.Input where
  | request (c : Videos.Command) (at_s : Nat)
  | job (key : Videos.Key) (outcome : Lanes.Schedule.Outcome Unit Videos.Answer)
  | noticed (key : Videos.Key)
  | visit (v : Videos.Visit)

inductive Videos.Command where
  | signIn (req : Nat) (who : Videos.Who) (name : String)
  | signOut (req : Nat) (member : Videos.Who) (session : Nat)
  | create (req : Nat) (member : Videos.Who) (session : Nat) (title : String) (about : String) (visibility : Videos.Visibility) (media : Videos.Media)
  | uploaded (req : Nat) (member : Videos.Who) (session : Nat) (video : Videos.VideoId)
  | like (req : Nat) (member : Videos.Who) (session : Nat) (video : Videos.VideoId) (on : Bool)
  | comment (req : Nat) (member : Videos.Who) (session : Nat) (video : Videos.VideoId) (body : String)
  | uncomment (req : Nat) (member : Videos.Who) (session : Nat) (video : Videos.VideoId) (comment : Nat)
  | delete (req : Nat) (member : Videos.Who) (session : Nat) (video : Videos.VideoId)
  | retry (req : Nat) (member : Videos.Who) (session : Nat) (video : Videos.VideoId)
  | report (req : Nat) (r : Videos.Report) (signature : String)

inductive Videos.Visibility where
  | public
  | unlisted
  | private

inductive Videos.Media where
  | mp4
  | webm
  | quicktime

inductive Bool where
  | false
  | true

inductive Videos.Report where
  | done (round : Videos.Round)
  | failed (round : Videos.Round)

inductive Lanes.Schedule.Outcome Unit Videos.Answer where
  | scheduled
  | already
  | refused (why : Lanes.Schedule.Refusal)
  | cancelled
  | succeeded (answer : Videos.Answer)
  | failed (payload : Unit) (attempts : Nat) (last : Option Videos.Answer)

inductive Lanes.Schedule.Refusal where
  | full
  | tooLarge

inductive Option Videos.Answer where
  | none
  | some (val : Videos.Answer)

inductive Videos.Visit where
  | like (req : Nat) (viewer : Option (Prod Videos.Who Nat)) (member : Videos.Who) (video : Videos.VideoId) (on : Bool)
  | comment (req : Nat) (viewer : Option (Prod Videos.Who Nat)) (member : Videos.Who) (name : String) (video : Videos.VideoId) (body : String)
  | uncomment (req : Nat) (viewer : Option (Prod Videos.Who Nat)) (member : Videos.Who) (video : Videos.VideoId) (comment : Nat)

inductive Option (Prod Videos.Who Nat) where
  | none
  | some (val : Prod Videos.Who Nat)

structure Prod Videos.Who Nat where
  fst : Videos.Who
  snd : Nat

